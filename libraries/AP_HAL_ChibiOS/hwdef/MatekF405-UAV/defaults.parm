# MatekF405-UAV verified hardware defaults
#
# Loaded at every boot. Values already saved in parameter storage override
# these defaults; parameters that only used old firmware defaults may change
# after an upgrade. Export and compare parameters before flight. Calibration
# values and experimental EKF tuning do not belong here.

# FS-i6/FS-A8S iBUS on UART2, exposed by ArduPilot as SERIAL5.
BRD_ALT_CONFIG 1
SERIAL5_PROTOCOL 23
SERIAL5_BAUD 115
SERIAL5_OPTIONS 0
RC_PROTOCOLS 1

# Optical-flow/rangefinder module on UART5, exposed as SERIAL4.
# Protocol 1 is MAVLink1, matching the verified module link.
SERIAL4_PROTOCOL 1
SERIAL4_BAUD 115
SERIAL4_OPTIONS 0
FLOW_TYPE 5
RNGFND1_TYPE 10
RNGFND1_MIN_CM 20
RNGFND1_MAX_CM 360
RNGFND1_ORIENT 25

# External HMC5883-compatible compass mounting used by this aircraft.
# Device ID and calibration offsets are intentionally not hard-coded.
COMPASS_EXTERNAL 1
COMPASS_ORIENT 6

# M5/M6 are reserved for the RZ7889 inputs. UserCode.cpp owns the actual
# 1 kHz, mutually-exclusive PWM output and always starts/stops at zero.
SERVO5_FUNCTION 94
SERVO6_FUNCTION 95

# Never weaken normal ArduPilot safety or remove the SD logging backend.
ARMING_CHECK 1
LOG_BACKEND_TYPE 1
LOG_DISARMED 0
